# Copy this file to .env and fill in real values. Never commit .env.

# AI provider selection: gemini (default) or openai
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional dev fallback, not the default provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Batch size for AI classification requests
BATCH_SIZE=20

# PDF/OCR (optional): leave blank if Tesseract/Poppler are on your system PATH
# (the normal case for a standard Tesseract/Poppler install). Only set these if
# they're installed to a non-standard location.
TESSERACT_CMD=
POPPLER_PATH=
